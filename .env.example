# =============================================================================
# SCM Platform - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=changeme

# Master/Slave hosts (Enterprise: read-write separation)
DB_MASTER_HOST=localhost
DB_SLAVE1_HOST=localhost
DB_SLAVE2_HOST=localhost

# Read replica for the read-write separation groups (spring.datasource.rw.groups.*.slaves)
# Leave these COMMENTED OUT when there is no replica: the slave URL then falls back to
# DB_HOST/DB_PORT and the credentials fall back to DB_USERNAME/DB_PASSWORD, so with no
# replica in place every read hits the primary and no replica infrastructure is needed.
# Do not "leave them empty" instead: Spring's `:default` placeholder only applies when
# the variable is absent, so an empty value resolves to "" and the blank slave URL /
# username fail ReadWriteProperties' @NotBlank validation - the service refuses to start.
# Fill all four in once a real replica exists; the replica account must be read-only.
#DB_SLAVE_HOST=
#DB_SLAVE_PORT=
#DB_SLAVE_USERNAME=
#DB_SLAVE_PASSWORD=

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Nacos (Service Discovery & Config Center)
# -----------------------------------------------------------------------------
NACOS_SERVER=localhost:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
# 璁块棶浠ょ墝鐨?HS512 绛惧悕瀵嗛挜锛氳嚦灏?64 涓瓧绗︼紝涓?auth/gateway 涓庢墍鏈変笟鍔℃湇鍔″繀椤讳竴鑷?# 锛圝wtUtils 鍚姩鏃朵細鏍￠獙闀垮害锛岀己澶卞垯鏈嶅姟鏃犳硶鍚姩锛沝ocker compose 鐨?core profile 寮哄埗瑕佹眰锛?#
# 涓嬮潰鐨勫€兼槸鍗犱綅绗︼紝浼氳鍚姩瀹堝崼鐩存帴鎷掔粷锛圫tartupSecretValidator / 缃戝叧
# SecurityConfigurationValidator锛夛細鏈嶅姟涓嶄細鐢ㄤ粨搴撻噷鍏紑鐨勫父閲忕鍙戜护鐗屻€傝鍏堢敓鎴愮湡瀹炲瘑閽ワ細
#   openssl rand -base64 64
JWT_SECRET=change-me-to-at-least-64-characters-long-random-string-0000000000

# -----------------------------------------------------------------------------
# Kafka
# -----------------------------------------------------------------------------
KAFKA_SERVERS=localhost:9092

# 瀹¤涓婃姤鐩爣鍦?Nacos 涓殑娉ㄥ唽鍚嶃€傛柊闀滃儚涓?platform-audit锛涘皻鏈崌绾ч暅鍍忕殑鏃х幆澧?# 闇€璁句负 scm-audit锛屽惁鍒欏璁″鎴风瑙ｆ瀽涓嶅埌瀹炰緥锛屼笂鎶ヤ細琚潤榛樹涪寮冿紙浠呮湁
# security_audit_delivery_failed_total 鎸囨爣鍙锛夈€?COGNORA_AUDIT_SERVICE_ID=platform-audit

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=changeme

# -----------------------------------------------------------------------------
# XXL-Job (Distributed Job Scheduler)
# -----------------------------------------------------------------------------
# XXL-Job 3.5.0 鐨?admin 浣跨敤鏍硅矾寰勶紙涓嶅啀甯?/xxl-job-admin锛?XXL_JOB_ADMIN=http://localhost:8088/
# 涓庤皟搴︿腑蹇冮厤缃殑 xxl.job.accessToken 涓€鑷达紱鐪熷疄鍊煎彧鍐欏湪 .env / scm-secrets锛屼笉鎻愪氦
XXL_JOB_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Sentinel Dashboard
# -----------------------------------------------------------------------------
SENTINEL_DASHBOARD=localhost:8858

# -----------------------------------------------------------------------------
# Gateway Security
# -----------------------------------------------------------------------------
# API Signature secrets (per application, min 32 characters)
API_SECRET_WEB_APP=
# Shared by the gateway signature filter, the internal RestClient signer
# (scm-common/web) and the scm-audit write guard. Every service that reports
# audit records must use the same value; scm-audit refuses to start when it is
# empty or still holds a shipped placeholder.
API_SECRET_INTERNAL_SERVICE=
# Legacy name for the secret above, still accepted as a fallback.
API_SECRET_INTERNAL_SECRET=

# App id sent as X-App-Id by the internal RestClient signer (an identifier, not a secret)
API_APP_ID=internal-service

# Identity token signing secret
IDENTITY_SIGNATURE_SECRET=

# mTLS keystore/truststore
KEYSTORE_PATH=classpath:certs/gateway-keystore.p12
KEYSTORE_PASSWORD=
TRUSTSTORE_PATH=classpath:certs/truststore.p12
TRUSTSTORE_PASSWORD=

# -----------------------------------------------------------------------------
# Auth Service
# -----------------------------------------------------------------------------
# SSL/TLS keystore
AUTH_KEYSTORE_PASSWORD=changeit
AUTH_TRUSTSTORE_PASSWORD=changeit

# -----------------------------------------------------------------------------
# Mail (Notification Service)
# -----------------------------------------------------------------------------
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
ENVIRONMENT=dev
RW_ENABLED=true

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
CQRS_LOG_LEVEL=INFO
SQL_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Alertmanager (Prometheus 鍛婅澶栧彂)
# -----------------------------------------------------------------------------
# 鍛婅鎺ユ敹 webhook锛孉lertmanager 浠ラ粯璁?JSON 杞借嵎 POST 鍒版鍦板潃銆?# 鐣欑┖ = 褰撳墠涓嶅鍙戯細瀹瑰櫒浣跨敤 null receiver锛屽憡璀︿粛鍙湪 Prometheus /
# Alertmanager 涓煡鐪嬶紱閰嶇疆鍚庝笅娆?docker compose up -d 鐢熸晥銆?ALERTMANAGER_WEBHOOK_URL=
